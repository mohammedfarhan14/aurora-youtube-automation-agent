# Application
METRICS_ENABLED=false
# Generate a random 32+ character token before enabling /metrics.
METRICS_BEARER_TOKEN=
OPERATIONS_ALERTS_ENABLED=false
OPERATIONS_ALERT_CHANNEL=email
APP_NAME=Aurora Studio
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# PostgreSQL (application/development database)
POSTGRES_DB=aurora_studio
POSTGRES_USER=aurora
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://aurora:CHANGE_ME@localhost:5433/aurora_studio

# Dedicated test database. Tests refuse to run unless this points to a
# PostgreSQL database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://aurora:CHANGE_ME@localhost:5433/aurora_studio_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Research retrieval is synthetic by default. Live providers require explicit opt-in.
# Supported modes: mock, wikipedia_http, crossref, multi_source,
# multi_source (Wikipedia, Crossref and official NASA.gov articles),
# multi_source_searxng (also adds fetched general web/news/science evidence).
RESEARCH_PROVIDER=mock
# When using multi_source_searxng, set this to a trusted, public HTTPS SearXNG
# instance. Search snippets are discovery only; Aurora fetches the result pages.
# RESEARCH_SEARXNG_BASE_URL=https://search.example.com
# Trend discovery is disabled by default. Enable only after approved worker egress is enforced.
# Supported modes: none, hacker_news, curated_rss, searxng.
TREND_DISCOVERY_PROVIDER=none
# When using curated_rss, configure 1-10 operator-approved HTTPS feeds as JSON.
# Each object must contain exactly "url" and "publisher".
# TREND_DISCOVERY_FEEDS=[{"url":"https://example.com/feed.xml","publisher":"Example News"}]
# SearXNG is an optional self-hosted search discovery source. It requires an
# HTTPS public endpoint in production and approved worker egress (issue #41).
# TREND_DISCOVERY_SEARXNG_BASE_URL=https://search.example.com
# TREND_DISCOVERY_SEARXNG_QUERY=science technology research discoveries

# Current background processing (PostgreSQL-backed email outbox worker)
EMAIL_OUTBOX_HEARTBEAT_INTERVAL_SECONDS=60

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RATE_LIMIT_IDENTITY_SECRET=
# Research-run enqueue limits per user and organization, per rolling fixed hour.
RESEARCH_RUN_USER_LIMIT=20
RESEARCH_RUN_ORGANIZATION_LIMIT=100
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BROWSER_SESSION_IDLE_TIMEOUT_MINUTES=30
BROWSER_SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Email delivery
INVITATION_EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_REPLY_TO=
# Legacy single key (version 1); retained for backward-compatible local setups.
# For rotation, configure a JSON keyring and one active version instead.
EMAIL_OUTBOX_ENCRYPTION_KEY=
# Example shape: {"1":"<64-hex-character-key>","2":"<64-hex-character-key>"}
EMAIL_OUTBOX_ENCRYPTION_KEYRING=
EMAIL_OUTBOX_ACTIVE_KEY_VERSION=1

# YouTube integration
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback
# Legacy single key (version 1); retained for backward-compatible local setups.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
# Example shape: {"1":"<64-hex-character-key>","2":"<64-hex-character-key>"}
INTEGRATION_TOKEN_ENCRYPTION_KEYRING=
INTEGRATION_TOKEN_ACTIVE_KEY_VERSION=1
YOUTUBE_OAUTH_STATE_TTL_SECONDS=600
YOUTUBE_FRONTEND_RESULT_URL=http://localhost:5173/settings/integrations
# The upload worker is disabled by default. Enable only with the isolated
# youtube-publish Compose profile and its allowlisted Squid egress proxy.
YOUTUBE_PUBLISH_WORKER_ENABLED=false
YOUTUBE_EGRESS_PROXY_URL=http://youtube-egress-proxy:3128
YOUTUBE_UPLOAD_CHUNK_SIZE_BYTES=8388608
YOUTUBE_UPLOAD_TIMEOUT_SECONDS=120
YOUTUBE_PUBLISH_POLL_INTERVAL_SECONDS=30
YOUTUBE_PUBLISH_LEASE_SECONDS=300
YOUTUBE_PUBLISH_MAX_ATTEMPTS=5
YOUTUBE_PUBLISH_RETRY_BASE_SECONDS=30

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# Authentication rate limits
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTRATION_IP_LIMIT=10
AUTH_VERIFICATION_RESEND_IP_LIMIT=10
INVITATION_EXPIRE_DAYS=7

# Email outbox worker tuning
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_MAX_CONCURRENCY=5
EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=5
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_INITIAL_RETRY_SECONDS=30
EMAIL_OUTBOX_LEASE_SECONDS=600
EMAIL_OUTBOX_DELIVERY_TIMEOUT_SECONDS=60

# Daily schedule dispatches ahead of the channel's target publication time.
CHANNEL_SCHEDULE_LEAD_MINUTES=60

# Research worker tuning
RESEARCH_WORKER_BATCH_SIZE=5
RESEARCH_WORKER_MAX_CONCURRENCY=3
RESEARCH_WORKER_POLL_INTERVAL_SECONDS=5
RESEARCH_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
RESEARCH_WORKER_MAX_ATTEMPTS=5
RESEARCH_WORKER_INITIAL_RETRY_SECONDS=30
RESEARCH_WORKER_MAX_RETRY_SECONDS=1800
RESEARCH_WORKER_LEASE_SECONDS=300
RESEARCH_WORKER_PROVIDER_TIMEOUT_SECONDS=120
RESEARCH_WORKER_SHUTDOWN_TIMEOUT_SECONDS=120

# Story production worker (disabled unless explicitly enabled)
STORY_WORKER_ENABLED=false
# Options: ollama (local native API), openai_compatible (default/local/custom), openai, openrouter,
# deepseek, huggingface_router, gemini, groq, anthropic. Hosted providers use the same
# API key field; endpoint must match the provider's canonical URL.
STORY_WORKER_PROVIDER=openai_compatible
# Configure an OpenAI-compatible endpoint only when intentionally enabling this worker.
# For local Ollama native chat (Qwen thinking controls and JSON schema),
# use STORY_WORKER_PROVIDER=ollama and http://host.docker.internal:11434
# Hosted endpoint examples (choose ONE provider, then set its API key/model):
# STORY_WORKER_PROVIDER=openrouter
# STORY_WORKER_LLM_BASE_URL=https://openrouter.ai/api/v1
# STORY_WORKER_PROVIDER=deepseek
# STORY_WORKER_LLM_BASE_URL=https://api.deepseek.com
# STORY_WORKER_PROVIDER=anthropic
# STORY_WORKER_LLM_BASE_URL=https://api.anthropic.com/v1
# STORY_WORKER_LLM_BASE_URL=
# STORY_WORKER_LLM_API_KEY=
# STORY_WORKER_MODEL=
# STORY_WORKER_VERIFICATION_MODEL=
# Optional provider control; set `none` for Qwen3 on Ollama `/v1` to skip its hidden reasoning budget.
# STORY_WORKER_REASONING_EFFORT=none
STORY_WORKER_TIMEOUT_SECONDS=120
STORY_WORKER_POLL_INTERVAL_SECONDS=5
STORY_WORKER_LEASE_SECONDS=900
STORY_WORKER_MAX_ATTEMPTS=5

# Media production worker (disabled unless explicitly enabled)
MEDIA_WORKER_ENABLED=false
MEDIA_WORKER_POLL_INTERVAL_SECONDS=5
MEDIA_WORKER_LEASE_SECONDS=600
MEDIA_WORKER_MAX_ATTEMPTS=5
MEDIA_STORAGE_BACKEND=local
# Local filesystem storage (development/single-node only):
# MEDIA_STORAGE_ROOT=/absolute/path/to/aurora-media
# S3-compatible storage (AWS S3, Cloudflare R2, MinIO):
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# MEDIA_S3_PROXY_URL=http://media-egress-proxy:3128
# MEDIA_S3_BUCKET=aurora-media
MEDIA_S3_REGION=auto
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_SESSION_TOKEN=
MEDIA_S3_TIMEOUT_SECONDS=30
MEDIA_STORAGE_MAX_OBJECT_BYTES=100000000
# Select a registered TTS adapter; mock is for non-production tests only.
# Supported now: mock, openai_compatible, kokoro, qwen3_tts, openai, and custom OpenAI-compatible endpoints.
# Native ElevenLabs, Piper and Azure adapters require their own contract-tested adapter modules.
MEDIA_TTS_PROVIDER=openai_compatible
MEDIA_TTS_SPEED=1.0
MEDIA_TTS_FORMAT=wav
MEDIA_TTS_LANGUAGES=["en-US"]
MEDIA_TTS_VOICES=["alloy"]
MEDIA_TTS_SAMPLE_RATES_HZ=[8000,16000,22050,24000,44100,48000]
MEDIA_TTS_HOSTING_MODE=self_hosted
MEDIA_TTS_MODEL_LICENSE_ID=
MEDIA_TTS_VOICE_LICENSE_ID=
MEDIA_TTS_COST_PER_1000_CHARACTERS_USD=
# Configure an explicitly managed OpenAI-compatible TTS endpoint; no paid fallback exists.
# Local development example: http://127.0.0.1:8880/v1
# Qwen3-TTS bridge: MEDIA_TTS_PROVIDER=qwen3_tts, model Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice.
# The bridge is a separately installed local service; see docs/operations/qwen3-tts-bridge.md.
# MEDIA_TTS_BASE_URL=
# Optional internal proxy for self-hosted TTS reachable from isolated workers.
# MEDIA_TTS_PROXY_URL=
# Optional IPv4 gateway override for Docker Desktop if its IPv6 host alias is
# unreachable from Squid; default host-gateway is used when unset.
# QWEN_TTS_HOST_GATEWAY_IP=host-gateway
# MEDIA_TTS_API_KEY=
# MEDIA_TTS_MODEL=
# MEDIA_TTS_VOICE=
# MEDIA_TTS_RIGHTS_BASIS=licensed
# MEDIA_TTS_LICENSE_ID=Apache-2.0
# MEDIA_TTS_LICENSE_URI=https://www.apache.org/licenses/LICENSE-2.0
# MEDIA_TTS_SOURCE_URI=https://example.com/model-and-voice-license-details
# MEDIA_TTS_ATTRIBUTION=Provider/model attribution required by the selected license
# Native ElevenLabs adapter (not OpenAI-compatible); API key is sent as xi-api-key.
# MEDIA_TTS_PROVIDER=elevenlabs
# MEDIA_TTS_BASE_URL=https://api.elevenlabs.io
# MEDIA_TTS_API_KEY=
# MEDIA_TTS_MODEL=eleven_multilingual_v2
# MEDIA_TTS_VOICE=
# MEDIA_TTS_HOSTING_MODE=hosted
# MEDIA_TTS_RIGHTS_BASIS=licensed
# MEDIA_TTS_LICENSE_ID=ElevenLabs commercial terms
# MEDIA_TTS_LICENSE_URI=https://elevenlabs.io/terms-of-use
# MEDIA_TTS_SOURCE_URI=https://elevenlabs.io/app/voice-library
# MEDIA_TTS_ATTRIBUTION=Attribution appropriate to the selected account and voice license

MEDIA_TTS_TIMEOUT_SECONDS=90
# The local demo uses rights-filtered Commons stills; choose local_abstract for offline cards.
# Choose local_abstract, wikimedia_commons, or comfyui. ComfyUI currently supplies scene stills.
MEDIA_VISUAL_PROVIDER=wikimedia_commons
# Default offline Chromium art direction is isolated to the media worker image.
MEDIA_VISUAL_COMPOSER=chromium_html
MEDIA_CHROMIUM_PATH=chromium
MEDIA_INSTALL_CHROMIUM=true
# Compose sets this to the media-only allowlisted proxy for Commons requests.
# MEDIA_VISUAL_PROXY_URL=
MEDIA_WIKIMEDIA_USER_AGENT=AuroraStudio/1.0 (https://github.com/mohammedfarhan14/aurora-youtube-automation-agent)
MEDIA_WIKIMEDIA_TIMEOUT_SECONDS=20
MEDIA_WIKIMEDIA_MAX_API_RESPONSE_BYTES=2000000
MEDIA_WIKIMEDIA_MAX_IMAGE_BYTES=20000000
# Optional local ComfyUI API workflow. Export an API-format workflow JSON into
# config/comfyui/ and replace input strings with {{PROMPT}},
# {{NEGATIVE_PROMPT}}, and {{SEED}}. Set output node ID to its SaveImage node.
# On Windows + WSL, the local launcher resolves the WSL host IP and routes
# ComfyUI through a dedicated proxy alias; do not bind ComfyUI to 0.0.0.0.
# MEDIA_COMFYUI_BASE_URL=http://comfyui.wsl.host:8188
# COMFYUI_WSL_HOST_IP is set by scripts/ops/start-aurora-demo.sh from the WSL default route.
# COMFYUI_WSL_HOST_IP=172.25.16.1
# MEDIA_COMFYUI_API_KEY=
# MEDIA_COMFYUI_WORKFLOW_PATH=/app/config/comfyui/workflow_api.json
# MEDIA_COMFYUI_OUTPUT_NODE_ID=9
# MEDIA_COMFYUI_TIMEOUT_SECONDS=300
# MEDIA_COMFYUI_NEGATIVE_PROMPT=blurry, low quality, illegible text, watermark
# MEDIA_COMFYUI_STYLE_PROMPT=cinematic documentary lighting, natural color, realistic detail
MEDIA_TTS_MAX_RESPONSE_BYTES=25000000
# Install FFmpeg/ffprobe separately in the media-worker runtime.
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
# Explicitly choose an encoder supported by the installed FFmpeg build and document its license.
# Example: libx264 (requires a GPL-enabled FFmpeg build).
# MEDIA_VIDEO_ENCODER=
MEDIA_AUDIO_ENCODER=aac
# static or gentle_drift (subtle per-scene camera motion on still visuals)
MEDIA_MOTION_STYLE=gentle_drift
MEDIA_VIDEO_PRESET=veryfast
MEDIA_VIDEO_CRF=23
